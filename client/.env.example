# Copy to client/.env (development) or set it in your frontend host's environment settings (production).
# VITE_ variables are read when the client is BUILT, and end up in the public JavaScript: never put a secret here.

# Where the backend API lives. Leave empty in development: Vite proxies /api to http://localhost:5000.
# In production (frontend and backend on different hosts) set the backend's URL, without a trailing slash:
# VITE_API_URL=https://your-api.example.com
VITE_API_URL=
