# Copy this file to server/.env and fill it in. server/.env is git-ignored: never commit it.
# On a hosting platform, set the same names in its "Environment variables" settings instead of using a file.

# ---- Database: MongoDB Atlas ----
# Atlas -> your cluster -> Connect -> Drivers -> copy the connection string (it contains the database user's password).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=attendance_record
# Atlas must allow this machine's / host's IP (Atlas -> Network Access). If "mongodb+srv" fails with "querySrv ECONNREFUSED",
# your router/VPN blocks the DNS SRV lookup; the app then retries through public DNS by itself, or force it here:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Server ----
PORT=5000
# The URL the FRONTEND is opened from (exactly, no trailing slash). Comma-separate several.
# Used for CORS and the cross-site request check. In production: https://your-frontend.example.com
CLIENT_ORIGIN=http://localhost:5173

# ---- Sign-in for the "Attendance Management" module ----
ADMIN_USERNAME=TAL Admin
# Used ONLY when the account is first created (stored as a salted hash, never as plain text).
# In development it defaults to Attendance2026. In production it MUST be set (min 10 characters).
# To change it later: npm run set-password -- "new password"
ADMIN_PASSWORD=
SESSION_HOURS=8

# ---- Deployment (production, frontend and backend on different hosts) ----
# NODE_ENV=production
# Behind the host's reverse proxy / HTTPS load balancer (Render, Railway, Fly, nginx...): TRUST_PROXY=1
# so the real client IP is used for the login lock and HTTPS is detected for Secure cookies.
# TRUST_PROXY=1
# Cookie mode - pick by where the two sites live:
#   strict (default): frontend and API on the SAME SITE (e.g. app.example.com + api.example.com, or one host).
#   none            : frontend and API on DIFFERENT sites (e.g. app.vercel.app + api.onrender.com).
#                     Needs HTTPS on both. Some browsers block third-party cookies, so a shared domain is more reliable.
# COOKIE_SAMESITE=strict
# Force the Secure flag on the session cookie when served over HTTPS (always on for COOKIE_SAMESITE=none):
# COOKIE_SECURE=true
# Failed sign-in limits per 15 minutes (defaults 8 per IP, 10 per username):
# LOGIN_MAX_PER_IP=8
# LOGIN_MAX_PER_USER=10
